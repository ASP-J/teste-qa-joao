# Credenciais do agent-playwright — copie para `.env` e preencha.
# `.env` está no .gitignore. NUNCA comitar credenciais.
#
# Como usar:
#   1. cp .env.example .env
#   2. preencha os valores abaixo
#   3. rode `npm run typecheck` pra validar
#
# Os placeholders `${VAR}` em `config/environment.json` resolvem destas variáveis.

# --- staging principal Twygo (stage10.stage.twygoead.com — orgId 36602) ---
TWYGO_STAGING_EMAIL=
TWYGO_STAGING_PASSWORD=

# --- staging "sem créditos de IA" (eduapi.stage.twygoead.com — orgId 36912) ---
# Usado por specs de bloqueio de funcionalidades quando a org está com saldo
# zerado. global-setup detecta envs com sufixo `-without-credits` e gera
# storage secundário em outputs/.auth/storage-without-credits.json.
TWYGO_STAGING_WITHOUT_CREDITS_EMAIL=
TWYGO_STAGING_WITHOUT_CREDITS_PASSWORD=

# --- staging do projeto Widgets (widgets.stage.twygoead.com — orgId 36988) ---
# Específico do projeto widgets — só preencha se for rodar essa suíte.
TWYGO_STAGING_WIDGETS_EMAIL=
TWYGO_STAGING_WIDGETS_PASSWORD=

# --- staging "widgets desabilitado" (widgetsdisabled.stage.twygoead.com — orgId 36989) ---
# Específico do projeto widgets, simulando módulo desligado.
# global-setup também detecta sufixo `-widgets-disabled`.
TWYGO_STAGING_WIDGETS_DISABLED_EMAIL=
TWYGO_STAGING_WIDGETS_DISABLED_PASSWORD=
